{
  "template_name": "ecommerce_checkout",
  "description": "Epistemic state rules for standard e-commerce checkout flows to detect skipped payment and authorization steps",
  "version": "1.0.0",
  "states": {
    "cart": {
      "description": "User has items in shopping cart",
      "required_context": ["user_id", "cart_items"],
      "optional_context": ["session_id", "coupon_code"]
    },
    "address": {
      "description": "User enters shipping/billing address",
      "required_context": ["user_id", "shipping_address"],
      "optional_context": ["billing_address"]
    },
    "shipping": {
      "description": "User selects shipping method",
      "required_context": ["user_id", "shipping_method"],
      "optional_context": ["shipping_cost"]
    },
    "payment": {
      "description": "User provides payment information",
      "required_context": ["user_id", "payment_method", "payment_token"],
      "optional_context": ["billing_address", "currency"]
    },
    "review": {
      "description": "User reviews order before confirmation",
      "required_context": ["user_id", "order_summary"],
      "optional_context": ["terms_accepted"]
    },
    "confirmation": {
      "description": "Order is confirmed and processed",
      "required_context": ["user_id", "order_id", "payment_confirmation"],
      "optional_context": ["confirmation_email"]
    },
    "complete": {
      "description": "Order is successfully completed",
      "required_context": ["user_id", "order_id", "order_status"],
      "optional_context": ["tracking_number"]
    }
  },
  "valid_transitions": [
    {
      "from": "cart",
      "to": "address",
      "conditions": ["cart_items_not_empty", "user_authenticated"]
    },
    {
      "from": "cart",
      "to": "payment",
      "conditions": ["cart_items_not_empty", "user_authenticated", "address_saved"]
    },
    {
      "from": "address",
      "to": "shipping",
      "conditions": ["shipping_address_valid"]
    },
    {
      "from": "address",
      "to": "payment",
      "conditions": ["shipping_address_valid", "shipping_method_saved"]
    },
    {
      "from": "shipping",
      "to": "payment",
      "conditions": ["shipping_method_selected"]
    },
    {
      "from": "payment",
      "to": "review",
      "conditions": ["payment_authorized", "payment_token_valid"]
    },
    {
      "from": "payment",
      "to": "confirmation",
      "conditions": ["payment_processed", "payment_successful"]
    },
    {
      "from": "review",
      "to": "confirmation",
      "conditions": ["terms_accepted", "order_reviewed"]
    },
    {
      "from": "confirmation",
      "to": "complete",
      "conditions": ["order_processed", "inventory_reserved"]
    }
  ],
  "forbidden_transitions": [
    {
      "from": "cart",
      "to": "confirmation",
      "reason": "Cannot skip payment and address steps"
    },
    {
      "from": "cart",
      "to": "complete",
      "reason": "Cannot skip all intermediate steps"
    },
    {
      "from": "address",
      "to": "complete",
      "reason": "Cannot skip payment step"
    },
    {
      "from": "shipping",
      "to": "complete",
      "reason": "Cannot skip payment step"
    },
    {
      "from": "review",
      "to": "complete",
      "reason": "Cannot skip confirmation step"
    },
    {
      "from": "payment",
      "to": "cart",
      "reason": "Cannot revert to cart after payment initiation"
    }
  ],
  "epistemic_rules": {
    "payment_bypass_detection": {
      "description": "Detect attempts to reach order completion without proper payment authorization",
      "rule": "Implies(target_state == 'complete', Exists(previous_state == 'payment') AND payment_successful == true)",
      "severity": "critical"
    },
    "address_skip_detection": {
      "description": "Detect attempts to skip address collection",
      "rule": "Implies(target_state == 'payment', Exists(previous_state == 'address') OR shipping_address_saved == true)",
      "severity": "high"
    },
    "shipping_method_skip_detection": {
      "description": "Detect attempts to skip shipping method selection",
      "rule": "Implies(target_state == 'payment', shipping_method_selected == true)",
      "severity": "medium"
    },
    "terms_acceptance_bypass": {
      "description": "Detect attempts to bypass terms and conditions acceptance",
      "rule": "Implies(target_state == 'confirmation', terms_accepted == true)",
      "severity": "high"
    },
    "cart_manipulation_detection": {
      "description": "Detect cart manipulation after payment initiation",
      "rule": "Implies(current_state == 'payment', cart_items_locked == true)",
      "severity": "high"
    }
  },
  "state_variables": {
    "user_id": {
      "type": "string",
      "description": "Unique user identifier"
    },
    "cart_items": {
      "type": "array",
      "description": "List of items in shopping cart"
    },
    "cart_items_not_empty": {
      "type": "boolean",
      "description": "Cart contains at least one item"
    },
    "user_authenticated": {
      "type": "boolean",
      "description": "User is logged in and authenticated"
    },
    "shipping_address": {
      "type": "object",
      "description": "Shipping address details"
    },
    "shipping_address_valid": {
      "type": "boolean",
      "description": "Shipping address passes validation"
    },
    "address_saved": {
      "type": "boolean",
      "description": "User has saved address on file"
    },
    "shipping_method": {
      "type": "string",
      "description": "Selected shipping method"
    },
    "shipping_method_selected": {
      "type": "boolean",
      "description": "User has selected a shipping method"
    },
    "shipping_method_saved": {
      "type": "boolean",
      "description": "Shipping method has been saved"
    },
    "payment_method": {
      "type": "string",
      "description": "Payment method type (credit_card, paypal, etc.)"
    },
    "payment_token": {
      "type": "string",
      "description": "Secure payment token"
    },
    "payment_token_valid": {
      "type": "boolean",
      "description": "Payment token is valid and not expired"
    },
    "payment_authorized": {
      "type": "boolean",
      "description": "Payment has been authorized by provider"
    },
    "payment_processed": {
      "type": "boolean",
      "description": "Payment has been processed"
    },
    "payment_successful": {
      "type": "boolean",
      "description": "Payment transaction was successful"
    },
    "order_summary": {
      "type": "object",
      "description": "Complete order summary including items, costs, and taxes"
    },
    "terms_accepted": {
      "type": "boolean",
      "description": "User has accepted terms and conditions"
    },
    "order_reviewed": {
      "type": "boolean",
      "description": "User has reviewed the order"
    },
    "order_id": {
      "type": "string",
      "description": "Unique order identifier"
    },
    "payment_confirmation": {
      "type": "string",
      "description": "Payment confirmation code"
    },
    "order_processed": {
      "type": "boolean",
      "description": "Order has been processed by the system"
    },
    "inventory_reserved": {
      "type": "boolean",
      "description": "Inventory has been reserved for order items"
    },
    "order_status": {
      "type": "string",
      "description": "Current order status"
    },
    "cart_items_locked": {
      "type": "boolean",
      "description": "Cart items are locked and cannot be modified"
    }
  },
  "z3_constraints": {
    "state_transition_validity": [
      "Forall(s1, s2: State, valid_transition(s1, s2) <=> transition_allowed(s1, s2))",
      "Forall(s: State, current_state(s) => Exists(prev: State, previous_state(prev) AND valid_transition(prev, s)))"
    ],
    "epistemic_guarantees": [
      "Implies(current_state == 'complete', Exists(path: Sequence[State], path.contains('payment') AND payment_successful == true))",
      "Implies(current_state == 'confirmation', payment_processed == true)",
      "Implies(current_state == 'payment', cart_items_not_empty == true AND user_authenticated == true)"
    ],
    "security_invariants": [
      "Forall(order: Order, order.status == 'complete' => order.payment_verified == true)",
      "Forall(session: Session, session.current_state == 'payment' => session.cart_locked == true)",
      "Forall(user: User, user.current_order != null => user.payment_method != null)"
    ]
  },
  "ebpf_tracepoints": {
    "http_request": {
      "events": [
        "POST /api/cart/items",
        "POST /api/checkout/address",
        "POST /api/checkout/shipping",
        "POST /api/checkout/payment",
        "POST /api/checkout/review",
        "POST /api/checkout/confirm",
        "GET /api/orders/{order_id}"
      ]
    },
    "function_calls": {
      "payment_processing": [
        "process_payment",
        "validate_payment_token",
        "authorize_payment"
      ],
      "order_processing": [
        "create_order",
        "reserve_inventory",
        "confirm_order"
      ]
    }
  },
  "detection_rules": {
    "skipped_payment": {
      "severity": "critical",
      "description": "Order completion reached without proper payment processing",
      "condition": "target_state == 'complete' AND NOT(Exists(previous_state == 'payment' AND payment_successful == true))",
      "mitigation": "Block order creation and require payment verification"
    },
    "skipped_address": {
      "severity": "high",
      "description": "Payment initiated without address validation",
      "condition": "target_state == 'payment' AND NOT(Exists(previous_state == 'address') OR address_saved == true)",
      "mitigation": "Require address entry before payment"
    },
    "price_manipulation": {
      "severity": "critical",
      "description": "Cart prices modified after payment authorization",
      "condition": "current_state == 'payment' AND cart_items_changed == true",
      "mitigation": "Lock cart items during payment process"
    },
    "terms_bypass": {
      "severity": "high",
      "description": "Order confirmed without terms acceptance",
      "condition": "target_state == 'confirmation' AND terms_accepted == false",
      "mitigation": "Require explicit terms acceptance"
    },
    "state_jump": {
      "severity": "medium",
      "description": "Invalid state transition detected",
      "condition": "NOT(valid_transition(previous_state, current_state))",
      "mitigation": "Log suspicious activity and potentially block transition"
    }
  }
}
